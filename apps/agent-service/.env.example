DESKTOPMATE_ENV=development
DESKTOPMATE_HOST=127.0.0.1
DESKTOPMATE_PORT=0
# Electron 会注入这个 token；不设置时服务启动时随机生成并通过 stdout 输出。
DESKTOPMATE_AUTH_TOKEN=
# 允许访问 WebSocket 的 Origin，逗号分隔；浏览器页面必须在这里列出。
DESKTOPMATE_ALLOWED_ORIGINS=http://localhost:5173,app://desktopmate
# 统一应用数据目录：sessions/knowledge/memory/profile 共用 desktopmate.db
DESKTOPMATE_APP_DATA_DIR=~/.desktopmate
DESKTOPMATE_TRACE_DIR=~/.desktopmate/traces
DESKTOPMATE_TRACE_RETENTION_DAYS=7
DESKTOPMATE_DRAFT_DIR=~/.desktopmate/drafts
DESKTOPMATE_MEMORY_DIR=~/.desktopmate/memory
DESKTOPMATE_MEMORY_BACKEND=sqlite
DESKTOPMATE_KNOWLEDGE_DB=~/.desktopmate/desktopmate.db
DESKTOPMATE_SESSION_DB=~/.desktopmate/desktopmate.db
DESKTOPMATE_SETTINGS_DIR=~/.desktopmate/settings
DESKTOPMATE_REDIS_URL=redis://127.0.0.1:16379/0
DESKTOPMATE_REDIS_MEMORY_KEY_PREFIX=desktopmate:memory
DESKTOPMATE_MEMORY_USER_ID=default_user
DESKTOPMATE_MEMORY_PROJECT_ID=
DESKTOPMATE_MEMORY_CONTEXT_LIMIT=8
DESKTOPMATE_KNOWLEDGE_DIR=~/.desktopmate/knowledge
DESKTOPMATE_MAX_UPLOAD_BYTES=10485760
DESKTOPMATE_SETTINGS_DIR=.desktopmate/settings
DESKTOPMATE_EMBEDDING_PROVIDER=fake
DESKTOPMATE_EMBEDDING_DIMENSIONS=128
DESKTOPMATE_EMBEDDING_API_KEY=
DESKTOPMATE_EMBEDDING_BASE_URL=
DESKTOPMATE_EMBEDDING_MODEL=text-embedding-3-small
DESKTOPMATE_MILVUS_ENABLED=false
DESKTOPMATE_MILVUS_URI=http://127.0.0.1:19530
DESKTOPMATE_MILVUS_COLLECTION_NAME=desktopmate_knowledge
# 显式设置允许工具访问的根目录，默认留空表示不开放文件工具。
DESKTOPMATE_ALLOWED_ROOTS=
DESKTOPMATE_MAX_READ_FILE_BYTES=5000000
DESKTOPMATE_MAX_SEARCH_FILES=100000
DESKTOPMATE_INTENT_ROUTER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
